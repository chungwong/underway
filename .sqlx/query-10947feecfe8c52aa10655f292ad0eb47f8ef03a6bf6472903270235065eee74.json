{
  "db_name": "PostgreSQL",
  "query": "\n            select \n                count(*) as \"total\",\n                sum(case when attempt_count = 1 then 1 else 0 end) as \"first_attempts\"\n            from underway.task\n            where state = $1 and task_queue_name = 'parallel_concurrency_pressure'\n            ",
  "describe": {
    "columns": [
      {
        "ordinal": 0,
        "name": "total",
        "type_info": "Int8"
      },
      {
        "ordinal": 1,
        "name": "first_attempts",
        "type_info": "Int8"
      }
    ],
    "parameters": {
      "Left": [
        {
          "Custom": {
            "name": "underway.task_state",
            "kind": {
              "Enum": [
                "pending",
                "in_progress",
                "waiting",
                "succeeded",
                "cancelled",
                "failed"
              ]
            }
          }
        }
      ]
    },
    "nullable": [
      null,
      null
    ]
  },
